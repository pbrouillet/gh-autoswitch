#!/usr/bin/env bash
#
# gh-autoswitch — auto-switch the active `gh` account before HTTPS git remote
# operations (push/pull/fetch/clone) by acting as a git credential helper.
#
# See README.md for details.

set -uo pipefail

PROG="gh-autoswitch"

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

config_file() {
  if [ -n "${GH_AUTOSWITCH_CONFIG:-}" ]; then
    printf '%s\n' "$GH_AUTOSWITCH_CONFIG"
    return
  fi
  local base="${XDG_CONFIG_HOME:-$HOME/.config}"
  printf '%s\n' "$base/gh-autoswitch/config"
}

gh_config_dir() {
  if [ -n "${GH_CONFIG_DIR:-}" ]; then
    printf '%s\n' "$GH_CONFIG_DIR"
    return
  fi
  local base="${XDG_CONFIG_HOME:-$HOME/.config}"
  printf '%s\n' "$base/gh"
}

hosts_file() {
  printf '%s\n' "$(gh_config_dir)/hosts.yml"
}

# ---------------------------------------------------------------------------
# Config lookup
# ---------------------------------------------------------------------------

# lookup_account HOST OWNER
# Prints the mapped gh account for host/owner, using exact match first then a
# "host/*" wildcard. Prints nothing when there is no match.
lookup_account() {
  local host="$1" owner="$2" file
  file="$(config_file)"
  [ -f "$file" ] || return 0

  local exact="$host/$owner" wild="$host/*"
  local exact_match="" wild_match=""
  local line key val

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"                       # strip comments
    line="${line#"${line%%[![:space:]]*}"}"  # ltrim
    line="${line%"${line##*[![:space:]]}"}"  # rtrim
    [ -z "$line" ] && continue
    case "$line" in
      *=*) ;;
      *) continue ;;
    esac
    key="${line%%=*}"
    val="${line#*=}"
    key="${key%"${key##*[![:space:]]}"}"     # rtrim key
    val="${val#"${val%%[![:space:]]*}"}"     # ltrim val
    val="${val%"${val##*[![:space:]]}"}"     # rtrim val
    [ -z "$val" ] && continue
    if [ "$key" = "$exact" ]; then
      exact_match="$val"
    elif [ "$key" = "$wild" ]; then
      wild_match="$val"
    fi
  done < "$file"

  if [ -n "$exact_match" ]; then
    printf '%s\n' "$exact_match"
  elif [ -n "$wild_match" ]; then
    printf '%s\n' "$wild_match"
  fi
}

# ---------------------------------------------------------------------------
# gh account state
# ---------------------------------------------------------------------------

# active_account HOST — prints the currently active gh account for HOST by
# reading gh's hosts.yml directly (offline, fast). Prints nothing if unknown.
active_account() {
  local host="$1" file
  file="$(hosts_file)"
  [ -f "$file" ] || return 0
  awk -v host="$host" '
    /^[^[:space:]].*:[[:space:]]*$/ {
      cur = $0
      sub(/:[[:space:]]*$/, "", cur)
      inblock = (cur == host)
      next
    }
    inblock && /^[[:space:]]+user:[[:space:]]*[^[:space:]]/ {
      line = $0
      sub(/^[[:space:]]*user:[[:space:]]*/, "", line)
      sub(/[[:space:]]*$/, "", line)
      print line
      exit
    }
  ' "$file"
}

# maybe_switch HOST ACCOUNT — switch the active account only when needed.
maybe_switch() {
  local host="$1" account="$2" current
  current="$(active_account "$host")"
  [ "$current" = "$account" ] && return 0
  gh auth switch --hostname "$host" --user "$account" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Credential helper
# ---------------------------------------------------------------------------

cmd_git_credential() {
  local op="${1:-}"
  local input host path owner account
  input="$(cat)"

  if [ "$op" = "get" ]; then
    host="$(printf '%s\n' "$input" | awk -F= '/^host=/{print $2; exit}')"
    path="$(printf '%s\n' "$input" | awk -F= '/^path=/{print $2; exit}')"
    owner="${path%%/*}"
    if [ -n "$host" ] && [ -n "$owner" ]; then
      account="$(lookup_account "$host" "$owner")"
      if [ -n "$account" ]; then
        maybe_switch "$host" "$account" || true
      fi
    fi
  fi

  # Always delegate to gh so git receives a valid credential, even if the
  # switch above failed for any reason (fail-safe).
  printf '%s\n' "$input" | gh auth git-credential "$op"
}

# ---------------------------------------------------------------------------
# Install / uninstall
# ---------------------------------------------------------------------------

self_path() {
  # Absolute path to this script.
  local src="${BASH_SOURCE[0]}" dir
  dir="$(cd "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  printf '%s/%s\n' "$dir" "$(basename "$src")"
}

cmd_install() {
  local host="github.com" scope="--global"
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --host=*) host="${1#*=}"; shift ;;
      --local) scope="--local"; shift ;;
      --global) scope="--global"; shift ;;
      *) echo "$PROG: unknown install option: $1" >&2; return 2 ;;
    esac
  done

  local self key helper
  self="$(self_path)"
  key="credential.https://$host.helper"
  helper="!\"$self\" git-credential"

  git config $scope --unset-all "$key" 2>/dev/null || true
  git config $scope --add "$key" ""          # clear inherited helpers
  git config $scope --add "$key" "$helper"
  git config $scope "credential.https://$host.useHttpPath" "true"

  echo "$PROG: installed credential helper for https://$host ($scope)"
  echo "  helper: $helper"
}

cmd_uninstall() {
  local host="github.com" scope="--global"
  while [ $# -gt 0 ]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --host=*) host="${1#*=}"; shift ;;
      --local) scope="--local"; shift ;;
      --global) scope="--global"; shift ;;
      *) echo "$PROG: unknown uninstall option: $1" >&2; return 2 ;;
    esac
  done
  git config $scope --unset-all "credential.https://$host.helper" 2>/dev/null || true
  git config $scope --unset "credential.https://$host.useHttpPath" 2>/dev/null || true
  echo "$PROG: removed credential helper for https://$host ($scope)"
}

# ---------------------------------------------------------------------------
# Doctor
# ---------------------------------------------------------------------------

cmd_doctor() {
  local host="${1:-github.com}"
  echo "gh-autoswitch doctor"
  echo "  config file : $(config_file)"
  if [ -f "$(config_file)" ]; then
    echo "  mappings    :"
    sed -e 's/^/      /' "$(config_file)" | grep -v '^\s*$' || true
  else
    echo "  mappings    : (none — file not found)"
  fi
  echo "  hosts.yml   : $(hosts_file)"
  echo "  active[$host] : $(active_account "$host")"
  echo "  git helper  :"
  git config --get-all "credential.https://$host.helper" 2>/dev/null | sed -e 's/^/      /' || true
  echo "  useHttpPath : $(git config --get "credential.https://$host.useHttpPath" 2>/dev/null)"
  command -v gh >/dev/null 2>&1 && echo "  gh          : $(command -v gh)" || echo "  gh          : NOT FOUND"
}

usage() {
  cat <<EOF
$PROG — auto-switch gh account for git remote operations

USAGE
  $PROG git-credential <get|store|erase>   Credential helper (called by git)
  $PROG install   [--host H] [--local|--global]
  $PROG uninstall [--host H] [--local|--global]
  $PROG doctor    [host]
  $PROG help

Config file: $(config_file)
  Format (one mapping per line):
    github.com/acme  = work_account
    github.com/*     = personal_account
EOF
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    git-credential) cmd_git_credential "$@" ;;
    install)        cmd_install "$@" ;;
    uninstall)      cmd_uninstall "$@" ;;
    doctor)         cmd_doctor "$@" ;;
    help|-h|--help) usage ;;
    *) echo "$PROG: unknown command: $cmd" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
