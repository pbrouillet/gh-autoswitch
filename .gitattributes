# Normalize line endings: store text as LF in the repo and check out LF on all
# platforms. Keeps diffs clean and matches what rustfmt and CI expect.
* text=auto eol=lf

# Explicitly treat these as text (LF).
*.rs    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
