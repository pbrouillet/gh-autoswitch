# gh-autoswitch config — map "host/owner" to a gh account username.
#
# Copy this file to:
#   Linux/macOS : ${XDG_CONFIG_HOME:-~/.config}/gh-autoswitch/config
#   Windows     : %APPDATA%\gh-autoswitch\config
# or point $GH_AUTOSWITCH_CONFIG at it.
#
# Precedence: an exact "host/owner" match wins over a "host/*" wildcard.
# If nothing matches, the active gh account is left unchanged.

# Exact owner/org mappings
github.com/acme-corp   = alice_work
github.com/alice       = alice_personal

# Per-host default (wildcard) — used when no exact owner match is found
github.com/*           = alice_personal

# GitHub Enterprise host example
# ghe.corp.example.com/* = alice_corp
